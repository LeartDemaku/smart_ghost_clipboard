# Konfigurimi i Smart Ghost Clipboard
# Kopjoni këtë skedar si .env dhe vendosni çelësin tuaj real

# Çelësi i detyrueshëm i OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# Opsionale: Modeli i AI (default: gpt-5.4-nano ose gpt-4o-mini / gpt-4o)
AI_MODEL=gpt-5.4-nano

# Opsionale: Base URL për OpenAI proxy, Ollama, LM Studio, ose Azure
# OPENAI_BASE_URL=https://api.openai.com/v1

# Opsionale: Shkurtorja globale e tastierës (default: <ctrl>+<shift>+v)
# HOTKEY_COMBINATION=<ctrl>+<shift>+v

# Opsionale: Timeout në sekonda për kërkesat e AI (default: 30.0)
# AI_TIMEOUT_SECONDS=30.0

